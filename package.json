{
    "name": "@plurnk/plurnk-mimetypes-grammar-fsharp",
    "version": "1.4.0",
    "description": "Pre-built tree-sitter-fsharp WASM grammar for @plurnk/plurnk-mimetypes.",
    "type": "module",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=26"
    },
    "exports": {
        ".": {
            "default": "./index.js"
        },
        "./package.json": "./package.json",
        "./fsharp.wasm": "./fsharp.wasm"
    },
    "files": [
        "fsharp.wasm",
        ".grammar-source",
        ".grammar-pin",
        "index.js",
        "README.md"
    ],
    "scripts": {
        "build:wasm": "node scripts/build-wasm.mjs",
        "verify:wasm": "node scripts/verify-wasm.mjs",
        "update:pin": "node scripts/update-pin.mjs",
        "update": "npm run update:pin && npm run build:wasm && npm run verify:wasm"
    },
    "devDependencies": {
        "tree-sitter-cli": "0.26.9"
    },
    "allowScripts": {
        "tree-sitter-cli@0.26.9": true
    },
    "peerDependencies": {
        "@plurnk/plurnk-mimetypes": "^1.4.0",
        "web-tree-sitter": "^0.25.0 || ^0.26.0"
    },
    "plurnk": {
        "builtAgainst": "1.4.0"
    }
}
